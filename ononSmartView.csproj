<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RhinoVersion Condition="'$(RhinoVersion)' == ''">8</RhinoVersion>
    <TargetFramework Condition="'$(RhinoVersion)' == '8'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(RhinoVersion)' == '9'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RhinoVersion)' == '7'">net48</TargetFramework>
    <DefineConstants Condition="'$(RhinoVersion)' == '7'">$(DefineConstants);RHINO7</DefineConstants>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>ononSmartView</AssemblyName>
    <RootNamespace>ononSmartView</RootNamespace>
    <Version>0.2.0-beta.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>Experimental Rhino 7/8/9 view navigation plug-in; known issues remain.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <UseRhinoRuntimeReferences Condition="'$(UseRhinoRuntimeReferences)' == ''">false</UseRhinoRuntimeReferences>
    <DisableImplicitFrameworkReferences Condition="'$(UseRhinoRuntimeReferences)' == 'true'">true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RhinoCommonPath)' == '' and '$(RhinoVersion)' == '7'">
    <RhinoCommonPath>$(MSBuildProjectDirectory)/work/rhino7-sdk/lib/net45/RhinoCommon.dll</RhinoCommonPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RhinoCommonPath)' == '' and '$(OS)' != 'Windows_NT'">
    <RhinoCommonPath>/Applications/Rhino $(RhinoVersion).app/Contents/Frameworks/RhCore.framework/Resources/RhinoCommon.dll</RhinoCommonPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RhinoCommonPath)' == '' and '$(OS)' == 'Windows_NT'">
    <RhinoCommonPath>$(ProgramFiles)/Rhino $(RhinoVersion)/System/RhinoCommon.dll</RhinoCommonPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="work/**;dist/**" />
    <Compile Remove="work/**;dist/**" />
    <None Update="ui/ononSmartView.rui" CopyToOutputDirectory="PreserveNewest" TargetPath="ononSmartView.rui" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseRhinoRuntimeReferences)' == 'true'">
    <Reference Include="$(RhinoRuntimePath)/*.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(RhinoVersion)' == '7'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoCommonPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
